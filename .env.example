# Copy this file to .env and fill in the values. Never commit .env.

# Server port (optional, default 3000)
PORT=3000

# MongoDB connection string
MONGO_URI=

# Secret used to sign login tokens. Any long random string.
JWT_SECRET=

# The account with this email becomes the first admin when it is verified
ADMIN_EMAIL=

# Verification emails. Optional: without a token, codes are printed in the server console.
# If you set the token, also set MAIL_FROM_EMAIL.
MAILTRAP_API_TOKEN=
MAIL_FROM_EMAIL=
# Optional, default "JacHacks Judging". Uncomment to change it.
# MAIL_FROM_NAME=